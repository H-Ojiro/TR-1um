(cnt &amp; sg_rr).output('ERRR36:SG(RR) ON CONT ER')  # 2026-09-23: Sync with Assura geomAnd to exclude touching edges

bgrr = (diff &amp; dlbgrr).inside(dlbgrr)
bgrr.enclosed(hpm, 1.4.um).output('[Addtional]ERBGRR01:HPM-L(BGRR) ENC ER 1.4')
bgrr.enclosed(pm, 1.4.um).output('[Addtional]ERBGRR02:PM-L(BGRR) ENC ER 1.4')
bgrr.enclosed(nm, 1.4.um).output('[Addtional]ERBGRR03:NM-L(BGRR) ENC ER 1.4')
bgrr.enclosed(psd, 1.4.um).output('[Addtional]ERBGRR04:PSD-L(BGRR) ENC ER 1.4')

cnt_bgrr=cnt_pol.inside(dlbgrr) # 2026-09-05
cnt_bgrr.separation(cnt, 1.0.um, transparent).output('[Additional]ERBGRR05:CONT(BGRR) SP ER 1.0')
(cnt_bgrr.without_bbox_min(1.0.um) + cnt_bgrr.without_bbox_max(1.0.um)).merged.output('[Additional]ERBGRR06:CONT(BGRR) WIDTH MUST 1.0')

(bgrr - hpm).output('[Additional]ERBGRR07:HPM NOT ON BGRR ER"')
(bgrr - pm).output('[Additional]ERBGRR08:PM NOT ON BGRR ER"')
(bgrr - nm).output('[Additional]ERBGRR09:NM NOT ON BGRR ER"')
(bgrr - psd).output('[Additional]ERBGRR10:PSD NOT ON BGRR ER"')

bgrr.not(psub).output("ERBGRR11:BGRR NOT ON PSUB ER") #geomAndNot(BGRR PSUB)
bgrr.not(hvnw).output("ERBGRR12:BGRR NOT ON HVNW ER") #geomAndNot(BGRR HVNW)
