###polygon_height
def polygon_height(polygon)#250303
  bbox = polygon.bbox#250303
  [bbox.height, bbox.width].max#250303
end#250303

###polygon_width
def polygon_width(polygon)#250303
  bbox = polygon.bbox#250303
  [bbox.height, bbox.width].min#250303
end#250303


