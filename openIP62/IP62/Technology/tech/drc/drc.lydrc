end#250721
ercsio06_1.output("ERCSIO06:M1(CSIO CL) SP MUST 10.0")#250721

ercsio06_1 = ercsio06_0.select do |polygon|#250721
  polygon_height(polygon) &gt; 10.001#250721
end#250721
ercsio06_1.output("ERCSIO06:M1(CSIO CL) SP MUST 10.0")#250721

ERCSIO15 = (psub &amp; dlcsio) ^ (nf &amp; dlcsio)
ERCSIO15.output('[Additional]ERCSIO15:CSIO PSUB-NF UNMATCH ER')

ercsio16_0 = (pol &amp; dlcsio) ^ (nsd &amp; dlcsio)
ercsio16_1 = (pol &amp; dlcsio) ^ (cl &amp; dlcsio)
ercsio16_2 = (nsd &amp; dlcsio) ^ (cl &amp; dlcsio)
ERCSIO16 = (ercsio16_0 + ercsio16_1 + ercsio16_2).merged
ERCSIO16.output('[Additional]ERCSIO16:CSIO SG-NSD-CL UNMATCH ER')
# ercsio16_0.output('[Debug]ercsio16_0')
# ercsio16_1.output('[Debug]ercsio16_1')
# ercsio16_2.output('[Debug]ercsio16_2')
#
dlcsio.interacting(hvnw).output("ERCSIO17:CSIO ON HVNW ER")
(csio - nf).output('[Additional]ERCSIO18:CSIO NOT ON NF ER')
(csio - hpm).output('[Additional]ERCSIO19:HPM NOT ON CSIO ER')
(csio - pm).output('[Additional]ERCSIO20:PM NOT ON CSIO ER')
(csio - nm).output('[Additional]ERCSIO21:NM NOT ON CSIO ER')
(csio - psd).output('[Additional]ERCSIO22:PSD NOT ON CSIO ER')
(diff_csio_cl - nsd).output('[Additional]ERCSIO23:NSD NOT ON CSIO ER')
(csio - nwl).output('[Additional]ERCSIO24:CSIO NOT ON NW ER')
(diff_csio_cl - cl).output('[Additional]ERCSIO26:CL NOT ON CSIO ER')

ercsio33_1 = nwl.overlapping(dlcsio)
ERCSIO33 = dlcsio ^ ercsio33_1
ERCSIO33.output('[Additional]ERCSIO33:NW-DLCSIO UNMATCH ER')

er0705_1 = pol.overlapping(dlrh) &amp; cnt
er0705_2 = ml1.overlapping(er0705_1)
er0705_2.outside(cnt.outside(pol).inside(dlbgrh)).output("ER0705:SG(RH) NOT CONNECT BGRH" )

er0706_1 = pol.overlapping(dlrr) &amp; cnt
er0706_2 = ml1.overlapping(er0706_1)
er0706_2.outside(cnt.outside(pol).inside(dlbgrr)).output("ER0706:SG(RR) NOT CONNECT BGRR" )

er0707_1 = pol.overlapping(dlrn) &amp; cnt
er0707_2 = ml1.overlapping(er0707_1)
er0707_2.outside(cnt.outside(pol).inside(dlbgrn)).output("ER0707:SG(RN) NOT CONNECT BGRN")

er0708_1 = pol.overlapping(dlrhhv) &amp; cnt
er0708_2 = ml1.overlapping(er0708_1)
er0708_2.outside(cnt.outside(pol).inside(dlbgrh)).output("ER0708:SG(RHHV) NOT CONNECT BGRH")

sg_rr = pol &amp; dlrr
errr37_1 = pol.covering(sg_rr)
errr37 = errr37_1.not(pol.covering(cnt))
errr37.output("ERRR37:SG(RR) CONNECT TO SG NOT ON CONT ER")

mpe.width(2.0.um).output('[Additional]ERMPE01:SG(MPE) WIDTH ER 2.0')
diff_mpe.enclosed(pol.interacting(diff_mpe), 1.2.um, projection).output('[Additional]ERMPE02:MP ENDCAP ER 1.2')

ermpe03_11 = cntl_mpe.separation(mpe, 3.0.um+1.dbu, projection).polygons
ermpe03_12 = cntl_mpe.separation(mpe, 3.0.um, projection).polygons
ermpe03_1 = ermpe03_11 - ermpe03_12
ermpe03_21 = cntl_mpe.separation(mpe, 7.0.um+1.dbu, projection).polygons
ermpe03_22 = cntl_mpe.separation(mpe, 7.0.um, projection).polygons
ermpe03_2 = ermpe03_21 - ermpe03_22
ermpe03_3 = diff_mpe.covering(ermpe03_1).covering(ermpe03_2)
ermpe03_4 = (ermpe03_3 - pol).overlapping(ermpe03_1)
ermpe03_5 = (cntl_mpe &amp; ermpe03_4).not_interacting(ermpe03_1)
ermpe03_6 = (ermpe03_3 - pol).overlapping(ermpe03_2)
ermpe03_7 = (cntl_mpe &amp; ermpe03_6).not_interacting(ermpe03_2)
ERMPE03 = ermpe03_5.output('[Additional+]ERMPE03:SG-CONTL(MPE S) SP MUST 3.0')
ERMPE04 = ermpe03_7.output('[Additional+]ERMPE04:SG-CONTL(MPE D) SP MUST 7.0')
# ermpe03_1.output('[Debug]ermpe03_1')
# ermpe03_2.output('[Debug]ermpe03_2')
# ermpe03_3.output('[Debug]ermpe03_3')
# ermpe03_4.output('[Debug]ermpe03_4')
# ermpe03_5.output('[Debug]ermpe03_5')
# ermpe03_6.output('[Debug]ermpe03_6')
# ermpe03_7.output('[Debug]ermpe03_7')

ermpe05_1 = diff_mpe.edges.with_angle(90.0)
cntl_mpe.edges.enclosed(ermpe05_1, 4.0, projection).output('[Additional]ERMPE05:L(MPE)-CONTL(YOKO) ENC ER 4.0')

ermpe06_0 = diff_mpe.corners(90.0, as_boxes)
ermpe06_1 = diff_mpe.edges.with_angle(diagonal_only)
ermpe06_2 = ermpe06_1.with_length(.. 1.97.um)
ERMPE06 = ermpe06_0 + ermpe06_2.extents
ERMPE06.output('[Additional]ERMPE06:L(MPE) DENKAI KANWA ER 1.4')

diff_mpe.enclosed(pbe, 1.4.um).output('[Additional]ERMPE07:PBE-L(MPE) ENC ER 1.4')
diff_mpe.enclosed(hpm, 1.4.um).output('[Additional]ERMPE08:HPM-L(MPE) ENC ER 1.4')
diff_mpe.enclosed(nm, 1.4.um).output('[Additional]ERMPE09:NM-L(MPE) ENC ER 1.4')
diff_mpe.enclosed(nsd, 1.4.um).output('[Additional]ERMPE10:NSD-L(MPE) ENC ER 1.4')

ermpe11_1 = diff_mpe &amp; pol
ermpe11_2 = ermpe11_1.edges.inside_part(diff_mpe)
ERMPE11 = ermpe11_2.with_length(.. 11.0.um)
ERMPE11.output('[Additional]ERMPE11:L(MPE) WIDTH ER 11')

(cntl_mpe.without_bbox_min(3.0.um) + cntl_mpe.without_bbox_max(3.0.um)).merged.output('[Additional]ERMPE12:CONT(MPE) WIDTH MUST 3.0')

cntl_mpe.space(1.6.um).output('[Additional]ERMPE13:CONTL(MPE) SP ER 1.6')

ermpe14_1 = pol.overlapping(diff_mpe)
cnt.enclosed(ermpe14_1, 0.8.um).output('[Additional]ERMPE14:SG CONT ENC ER 0.8')

mpe.not(psub).output('[Additional]ERMPE15:MPE NOT ON PSUB ER')
mpe.not(nwl).output('[Additional]ERMPE16:MPE NOT ON NW ER')
mpe.not(nf).output('[Additional]ERMPE17:MPE NOT ON NF ER')
mpe.not(pf).output('[Additional]ERMPE18:MPE NOT ON PF ER')
mpe.not(pbe).output('[Additional]ERMPE19:MPE NOT ON PBE ER')
mpe.not(hpm).output('[Additional]ERMPE20:MPE NOT ON HPM ER')
mpe.not(nm).output('[Additional]ERMPE21:MPE NOT ON NM ER')
mpe.not(nsd).output('[Additional]ERMPE22:MPE NOT ON NSD ER')

mpe.and(hvnw).output("ERMPE23:MPE ON HVNW ER")
mpe.and(cl).output("ERMPE24:CL ON MPE ER")
mpe.and(hpbe).output("ERMPE25:HPBE ON MPE ER")
mpe.and(hnbe).output("ERMPE26:HNBE ON MPE ER")
mpe.and(nbe).output("ERMPE27:NBE ON MPE ER")
mpe.and(pm).output("ERMPE28:PM ON MPE ER")
mpe.and(r).output("ERMPE29:R ON MPE ER")
mpe.and(narea).output("ERMPE30:PSD ON MPE ER")

cntl_mpe.enclosed(diff_mpe, 2.5.um, projection).output('[Additional]ERMPE31:L(MPE)-CONTL(TATE) ENC ER 2.5')

diff_mpe.enclosed((psub &amp; dlwlmp), 7.0.um).output('[Additional]ERWLMP14:PSUB(WLMP)-L(MPE) ENC ER 7.0')
diff_mpe.separation(diff_bgmp, 10.0.um).output('[Additional]ERWLMP15:L(MPE)-L(BGMP) SP ER 10.0')
cnt.separation(diff_mpe, 2.0.um).output('[Additional]ERWLMP16:L(MPE)-CONT SP ER 2.0')
diff_mpe.space(1.4.um).output('[Additional]ERWLMP17:L(MPE) SP ER 1.4')
pol.separation(diff_mpe, 0.4.um).output('[Additional]ERWLMP18:SG-L(MPE) SP ER 0.4')

erwlmp19_0 = (psub &amp; dlwlmp) ^ (nf &amp; dlwlmp)
erwlmp19_1 = (psub &amp; dlwlmp) ^ (pf &amp; dlwlmp)
erwlmp19_2 = (pf &amp; dlwlmp) ^ (nf &amp; dlwlmp)
ERWLMP19 = (erwlmp19_0 + erwlmp19_1 + erwlmp19_2).merged
ERWLMP19.output('[Additional]ERWLMP19:PSUB-NF-PF UNMATCH ER')

erwlmp21_1 = nwl.outside(dlcsio).outside(chipring)
ERWLMP21 = erwlmp21_1 ^ dlwlmp
ERWLMP21.output('[Additional]ERWLMP21:DLWLMP-NW UNMATCH ER')

erwlmp22_1 = mpe + bgmp + dp
# erwlmp22_1.output('[Debug]erwlmp22_1')
erwlmp22_1.not(psub).output('[Additional]ERWLMP22:PSUB NOT ON WLMP ER')

mne.width(2.0.um).output('[Additional]ERMNE01:SG(mne) WIDTH ER 2.0')
diff_mne.enclosed(pol.interacting(diff_mne), 1.2.um, projection).output('[Additional]ERMNE02:MP ENDCAP ER 1.2')

diff_mne.enclosed(nbe, 1.4.um).output('[Additional]ERMPE03:NBE-L(MNE) ENC ER 1.4')
diff_mne.enclosed(hpm, 1.4.um).output('[Additional]ERMPE04:HPM-L(MNE) ENC ER 1.4')
diff_mne.enclosed(pm, 1.4.um).output('[Additional]ERMPE05:PM-L(MNE) ENC ER 1.4')
diff_mne.enclosed(psd, 1.4.um).output('[Additional]ERMPE06:PSD-L(MNE) ENC ER 1.4')

ermne07_1 = pol.overlapping(diff_mne)
cnt.enclosed(ermne07_1, 0.8.um).output('[Additional]ERMNE07:SG CONT ENC ER 0.8')

ermne08_11 = cntl_mne.separation(mne, 3.0.um+1.dbu, projection).polygons
ermne08_12 = cntl_mne.separation(mne, 3.0.um, projection).polygons
ermne08_1 = ermne08_11 - ermne08_12
ermne08_21 = cntl_mne.separation(mne, 7.0.um+1.dbu, projection).polygons
ermne08_22 = cntl_mne.separation(mne, 7.0.um, projection).polygons
ermne08_2 = ermne08_21 - ermne08_22
ermne08_3 = diff_mne.covering(ermne08_1).covering(ermne08_2)
ermne08_4 = (ermne08_3 - pol).overlapping(ermne08_1)
ermne08_5 = (cntl_mne &amp; ermne08_4).not_interacting(ermne08_1)
ermne08_6 = (ermne08_3 - pol).overlapping(ermne08_2)
ermne08_7 = (cntl_mne &amp; ermne08_6).not_interacting(ermne08_2)
ERMNE08 = ermne08_5.output('[Additional+]ERMNE08:SG-CONTL(MNE S) SP MUST 3.0')
ERMNE09 = ermne08_7.output('[Additional+]ERMNE09:SG-CONTL(MNE D) SP MUST 7.0')

ermne10_1 = diff_mne.edges.with_angle(90.0)
cntl_mne.edges.enclosed(ermne10_1, 4.0, projection).output('[Additional]ERMNE10:L(MNE)-CONTL(YOKO) ENC ER 4.0')

ermne12_1 = diff_mne &amp; pol
ermne12_2 = ermne12_1.edges.inside_part(diff_mne)
ERMNE12 = ermne12_2.with_length(.. 11.0.um)
ERMNE12.output('[Additional]ERMNE12:L(MNE) WIDTH ER 11')

(cntl_mne.without_bbox_min(3.0.um) + cntl_mne.without_bbox_max(3.0.um)).merged.output('[Additional]ERMNE13:CONT(MNE) WIDTH MUST 3.0')

cntl_mne.space(1.6.um).output('[Additional]ERMNE14:CONTL(MNE) SP ER 1.6')

ermne15_0 = diff_mne.corners(90.0, as_boxes)
ermne15_1 = diff_mne.edges.with_angle(diagonal_only)
ermne15_2 = ermne15_1.with_length(.. 1.97.um)
ERMNE15 = ermne15_0 + ermne15_2.extents
ERMNE15.output('[Additional]ERMNE15:L(MNE) DENKAI KANWA ER 1.4')


mne.and(psub).output("ERMNE16:MNE ON PSUB ER")
mne.and(nwl).output("ERMNE17:MNE ON NW ER")
mne.and(nf).output("ERMNE18:MNE ON NF ER")
mne.and(pf).output("ERMNE19:MNE ON PF ER")

mne.not(nbe).output('[Additional]ERMNE20:MNE NOT ON NBE ER')
mne.not(hpm).output('[Additional]ERMNE21:MNE NOT ON HPM ER')
mne.not(pm).output('[Additional]ERMNE22:MNE NOT ON PM ER')
mne.not(nm).output('[Additional]ERMNE23:MNE NOT ON NM ER')
mne.not(psd).output('[Additional]ERMNE24:MNE NOT ON PSD ER')

mne.and(cl).output("ERMNE25:CL ON MNE ER")
mne.and(hpbe).output("ERMNE26:HPBE ON MNE ER")
mne.and(hnbe).output("ERMNE27:HNBE ON MNE ER")
mne.and(pbe).output("ERMNE28:PBE ON MNE ER")
mne.and(r).output("ERMNE29:R ON MNE ER")
mne.and(parea).output("ERMNE30:NSD ON MNE ER")
mne.and(hvnw).output("ERMNE31:MNE ON HVNW ER")

cntl_mne.enclosed(diff_mne, 2.5.um, projection).output('[Additional]ERMNE31:L(MNE)-CONTL(TATE) ENC ER 2.5')

if defined? extra_drc_check
  extra_drc_check mpo, psub, hvnw, nf, nwl, pf, cl, hnbe, hpbe, pbe, nbe, hpm, r, rhp, diff,
      dlmpo, dlbgmpo, narea, parea, dlmno, mno, dlbgmn, dlrh, dlbgrh, bgrh, rhhv, pol, dlrhhv, dlrn, dlbgrn,
      rnhv, dlrnhv, cnt
end</text>
</klayout-macro>
