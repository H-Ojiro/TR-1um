rr.enclosed(nm, 1.4.um).output('[Additional]ERRR03:NM-L(RR) ENC ER 2.0')
rr.enclosed(nsd, 1.4.um).output('[Additional]ERRR04:NSD-L(RR) ENC ER 2.0')
rr.enclosed(r, 1.4.um).output('[Additional]ERRR05:R-L(RR) ENC ER 2.0')
(pol &amp; dlrr).width(2.0.um).output('[Additional]ERRR06:SG(RR) WIDTH ER 2.0')
psd.edges.inside_part(rr).with_length(.. 2.8.um).output('[Additional]ERRR07:L(RR) WIDTH ER 2.8')

cnt_rr=cnt_pol.inside(rr) # 2026-09-06
errr08_1 = rr.edges.with_angle(ortho)
errr08_2 = errr08_1.outside(psd)
errr08_3 = cnt_rr.edges.enclosed(errr08_2, 1.5.um, projection)
ERRR08 = errr08_3.output('[Additional]ERRR08:L(RR top)-CONTL ENC ER 1.5')

errr09_1 = rr.corners(90.0, as_boxes)
errr09_2 = rr.edges.with_angle(diagonal_only)
# errr09_3 = errr09_2.with_length(.. 1.414213562)
errr09_3 = errr09_2.with_length(.. 1.41449.um)
ERRR09 = errr09_1 + errr09_3.extents
ERRR09.output('[Additional]ERRR09:L(RR) DENKAI KANWA ER 1.0')

errr10_0 = psd.edges.inside_part(rr).with_length(4.0.um ..)
errr10_1 = rr.overlapping(errr10_0.extended_out(1.dbu))
errr10_2 = cnt_rr &amp; errr10_1
errr10_31 = errr10_2.sized(-0.5.um+1.dbu).sized(0.5.um-1.dbu)
errr10_32 = errr10_2.sized(-0.5.um).sized(0.5.um)
errr10_3 = errr10_2 - (errr10_31 - errr10_32)
errr10_4 = errr10_2.with_bbox_max(1.0.um+1.dbu .. 1.6.um)
errr10_5 = errr10_2.with_bbox_min(1.0.um) &amp; errr10_2.with_bbox_max(1.0.um)
ERRR10 = (errr10_3 + errr10_4 + errr10_5).merged
ERRR10.output('[Additional]ERRR10:CONTL long side WIDTH ER 1.6,CONTL short side WIDTH MUST 1.0(when m>=4.0)')
