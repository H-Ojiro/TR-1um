diff_csio_ring.enclosed(hpm, 1.4.um).output('[Additional]ERCSIO07:HPM-L(CSIO RING) ENC ER 1.4')
diff_csio_ring.enclosed(pm, 1.4.um).output('[Additional]ERCSIO08:PM-L(CSIO RING) ENC ER 1.4')
