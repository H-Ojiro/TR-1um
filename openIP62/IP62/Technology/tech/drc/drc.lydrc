rr.interacting(hnbe).output("ERRR31:HNBE ON RR ER")
rr.interacting(pbe).output("ERRR32:PBE ON RR ER")
rr.interacting(nbe).output("ERRR33:NBE ON RR ER")
rr.interacting(rhp).output("ERRR34:RHP ON RR ER")

errr35_0 = psd.edges.inside_part(rr).with_length(2.8.um+1.dbu ..)
errr35_1 = errr35_0.extents(0.1.um)
errr35_2 = psd.edges.inside_part(rr).with_length(.. 4.0.um)
errr35_3 = errr35_2.extents(0.1.um)
ERRR35 = errr35_1 &amp; errr35_3
