# errr10_5.output('[Debug]errr10_5')

errr11_0 = psd.edges.inside_part(rr).with_length(2.8.um)
errr11_1 = rr.overlapping(errr11_0.extended_out(1.dbu))
errr11_2 = cnt_rr &amp; errr11_1
(errr11_2.without_bbox_min(1.0.um) + errr11_2.without_bbox_max(1.0.um)).merged.output('[Additional]ERRR11:CONT WIDTH MUST 1.0(when m=2.8)')

errr13_0 = cnt_rr &amp; errr10_1
errr13_0.enclosed(rr, 1.2.um, projection).output('[Additional]ERRR13:L(RR)-CONTL ENC ER 1.2(when m>=4.0)')

errr14_0 = cnt_rr &amp; errr11_1
errr14_0.enclosed(rr, 0.9.um, projection).output('[Additional]ERRR14:L(RR)-CONTL ENC ER 0.8(when m=2.8)')

errr15_1 = rr.edges.with_angle(ortho)
errr15_2 = errr15_1.extended_out(1.0.um)
errr15_3 = errr15_2.edges.raw.and((pol &amp; dlrr).edges.raw)
ERRR15 = errr15_2.not_interacting(errr15_3).output('[Addtional]ERRR15:SG-L(RR) SP MUST 1.0')

ERRR16 = rr.enclosed(psd, 2.0.um, projection).output('[Additional]ERRR16:PSD-L(RR) CROSS ER 2.0')

errr17_1 = rr &amp; (cnt &amp; dlrr)
errr17_2 = rr &amp; psd
errr17_3 = errr17_1 + errr17_2
errr17_4 = errr17_3.separation(errr17_3, 4.2.um, projection).edges
errr17_5 = errr17_3.separation(errr17_3, 4.2.um+1.dbu, projection).edges
errr17_6 = errr17_5 - errr17_4
# errr17_7 = errr17_3.edges.raw.and(errr17_6)
errr17_7 = errr17_3.interacting(errr17_3.edges.raw.and(errr17_6))
ERRR17 = errr17_3 - errr17_7
ERRR17.output('[Additional]ERRR17:PSD-CONTL(RR) SP ER 4.2')
