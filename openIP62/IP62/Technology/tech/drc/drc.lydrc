cont_csio = cont_csio_cl | cont_csio_ring
cont_csio.without_perimeter(4.8.um).output("ERCSIO01:CONT(CSIO) WIDTH MUST 1.2")
(cont_csio.without_bbox_min(1.2.um) + cont_csio.without_bbox_max(1.2.um)).merged.output('[Additional]ERCSIO01:CONT(CSIO) WIDTH MUST 1.2') # 2026-09-04
ml1.enclosing(cont_csio_ring, 1.2.um).output("ERCSIO02:M1-CONT(CSIO RING) ENC ER 1.2")
cont_csio_cl.enclosed(csio, 2.9.um).output('[Additional]ERCSIO03:L(CSIO_CL)-CONT(CSIO) ENC ER 2.9')

diff_csio_ring = csio - (pol &amp; dlcsio)
diff_csio_cl = csio &amp; (pol &amp; dlcsio)

diff_csio_ring.enclosed(psub, 3.0.um).output('[Additional]ERCSIO04:PSUB-L(CSIO RING) ENC ER 3.0')
